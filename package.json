{
  "name": "tinymagiq-backend",
  "version": "1.0.0",
  "description": "Template management system with versioning support",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:api": "node src/scripts/test-api.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "db:migrate": "node src/config/migrate.js",
    "db:seed": "node src/scripts/seed.js",
    "build": "npm run db:migrate",
    "postinstall": "npm run db:migrate"
  },
  "keywords": [
    "templates",
    "api",
    "nodejs",
    "postgresql",
    "versioning",
    "chat"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.2.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "langfuse": "^3.38.5",
    "mkdirp": "^3.0.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "openai": "^5.23.0",
    "pg": "^8.16.0",
    "readable-stream": "^4.7.0",
    "util-deprecate": "^1.0.2"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
